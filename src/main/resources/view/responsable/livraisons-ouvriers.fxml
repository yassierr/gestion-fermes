<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  Écran Responsable : Livraisons & Ouvriers (maquettes pages 39-40).
  Chemin : src/main/resources/view/responsable/livraisons-ouvriers.fxml
  Contrôleur : ma.ferme.controller.responsable.LivraisonOuvrierController
-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ma.ferme.controller.responsable.LivraisonOuvrierController"
      stylesheets="@../../css/livraisons-ouvriers.css"
      styleClass="lo-page-root"
      spacing="14">

    <padding>
        <Insets top="22" right="28" bottom="22" left="28"/>
    </padding>

    <!-- ===== EN-TÊTE ===== -->
    <VBox spacing="3">
        <Label text="OPÉRATIONS DE TERRAIN &amp; LOGISTIQUE" styleClass="lo-eyebrow"/>
        <Label text="Livraisons &amp; Ouvriers" styleClass="lo-page-title"/>
        <Label fx:id="lblFerme" text="Ferme :" styleClass="lo-page-subtitle"/>
    </VBox>

    <!-- ===== BASCULE LIVRAISONS / OUVRIERS ===== -->
    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="lo-page-tabs">

        <!-- ───────── LIVRAISONS ───────── -->
        <Tab text="Livraisons">
            <VBox spacing="16">
                <padding>
                    <Insets top="14" right="0" bottom="0" left="0"/>
                </padding>

                <HBox spacing="16">
                    <VBox styleClass="lo-kpi-card" HBox.hgrow="ALWAYS" spacing="6">
                        <Label text="TOTAL EXPÉDIÉ" styleClass="lo-kpi-title"/>
                        <Label fx:id="lblVolume" text="0 kg" styleClass="lo-kpi-value"/>
                    </VBox>
                    <VBox styleClass="lo-kpi-card" HBox.hgrow="ALWAYS" spacing="6">
                        <Label text="MONTANT CUMULÉ" styleClass="lo-kpi-title"/>
                        <Label fx:id="lblMontant" text="0 MAD" styleClass="lo-kpi-value"/>
                    </VBox>
                    <VBox styleClass="lo-kpi-card" HBox.hgrow="ALWAYS" spacing="6">
                        <Label text="PRIX MOYEN / KG" styleClass="lo-kpi-title"/>
                        <Label fx:id="lblPrixMoyen" text="0 MAD" styleClass="lo-kpi-value"/>
                    </VBox>
                </HBox>

                <VBox styleClass="lo-table-card" spacing="10" VBox.vgrow="ALWAYS">
                    <Label text="Livraisons de la ferme" styleClass="lo-section-title"/>

                    <TableView fx:id="tableLivraisons" VBox.vgrow="ALWAYS">
                        <placeholder>
                            <Label text="Aucune livraison pour cette ferme."/>
                        </placeholder>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colBon" text="N° BON"/>
                            <TableColumn fx:id="colDate" text="DATE"/>
                            <TableColumn fx:id="colClient" text="DESTINATION"/>
                            <TableColumn fx:id="colQuantite" text="KG PRÉLEVÉS"
                                         style="-fx-alignment: CENTER-RIGHT;"/>
                            <TableColumn fx:id="colPrix" text="PRIX/KG"
                                         style="-fx-alignment: CENTER-RIGHT;"/>
                            <TableColumn fx:id="colMontantLigne" text="MONTANT (MAD)"
                                         style="-fx-alignment: CENTER-RIGHT;"/>
                            <TableColumn fx:id="colStatut" text="STATUT"
                                         style="-fx-alignment: CENTER;"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </Tab>

        <!-- ───────── OUVRIERS ───────── -->
        <Tab text="Ouvriers">
            <VBox spacing="16">
                <padding>
                    <Insets top="14" right="0" bottom="0" left="0"/>
                </padding>

                <HBox spacing="16">
                    <VBox styleClass="lo-kpi-card-top" HBox.hgrow="ALWAYS" spacing="6">
                        <Label text="EFFECTIF GLOBAL DÉPLOYÉ" styleClass="lo-kpi-title"/>
                        <Label fx:id="lblEffectif" text="0 ouvriers" styleClass="lo-kpi-value-dark"/>
                    </VBox>
                    <VBox styleClass="lo-kpi-card-top" HBox.hgrow="ALWAYS" spacing="6">
                        <Label text="TOTAL DES PAIES VERSÉES" styleClass="lo-kpi-title"/>
                        <Label fx:id="lblTotalPaies" text="0 MAD" styleClass="lo-kpi-value-dark"/>
                    </VBox>
                </HBox>

                <VBox styleClass="lo-table-card" spacing="10" VBox.vgrow="ALWAYS">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <VBox spacing="2">
                            <Label text="Historique des Reçus de Paie" styleClass="lo-section-title"/>
                            <Label text="Reçus émis pour les ouvriers de la ferme"
                                   styleClass="lo-section-hint"/>
                        </VBox>
                        <HBox HBox.hgrow="ALWAYS"/>
                        <Button text="Reçu PDF" onAction="#onRecuPdf" styleClass="lo-btn-primary"/>
                    </HBox>

                    <TableView fx:id="tableRecus" VBox.vgrow="ALWAYS">
                        <placeholder>
                            <Label text="Aucun reçu de paie pour cette ferme."/>
                        </placeholder>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colNumero" text="N° REÇU"/>
                            <TableColumn fx:id="colDatePaie" text="DATE DE PAIEMENT"/>
                            <TableColumn fx:id="colPeriode" text="PÉRIODE"/>
                            <TableColumn fx:id="colNbOuvriers" text="OUVRIERS PAYÉS"
                                         style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colTotal" text="MONTANT PAYÉ"
                                         style="-fx-alignment: CENTER-RIGHT;"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
