<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!--
  Écran « Dépenses » du responsable (maquette « Dépenses »).
  Chargé dans la zone centrale de responsable-main.fxml : la barre latérale n'est pas ici.
  Contrôleur : ma.ferme.controller.responsable.DepenseController (le même sert la modale depense-form.fxml)
  Styles     : css/depenses.css
-->
<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ma.ferme.controller.responsable.DepenseController"
            styleClass="page" fitToWidth="true" hbarPolicy="NEVER">

    <stylesheets>
        <URL value="@../../css/depenses.css"/>
    </stylesheets>

    <VBox spacing="22.0" styleClass="page-content">
        <padding>
            <Insets top="28.0" right="36.0" bottom="48.0" left="36.0"/>
        </padding>

        <!-- Titre -->
        <Label text="Dépenses" styleClass="page-title"/>

        <!-- Total du mois -->
        <VBox styleClass="stat-card" prefWidth="270.0" maxWidth="270.0" spacing="8.0">
            <HBox alignment="CENTER_LEFT">
                <Label text="TOTAL DÉPENSES DU MOIS" styleClass="stat-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane styleClass="stat-icon-box" minWidth="24.0" minHeight="24.0"
                           prefWidth="24.0" prefHeight="24.0" maxWidth="24.0" maxHeight="24.0">
                    <SVGPath styleClass="icone-stat"
                             content="M21 12V7H5a2 2 0 0 1 0-4h14v4 M3 5v14a2 2 0 0 0 2 2h16v-5 M18 12a2 2 0 0 0 0 4h4v-4z"/>
                </StackPane>
            </HBox>
            <HBox alignment="BASELINE_LEFT" spacing="5.0">
                <Label fx:id="lblTotalMois" text="0" styleClass="stat-value"/>
                <Label text="MAD" styleClass="stat-unit"/>
            </HBox>
        </VBox>

        <!-- Barre d'outils : recherche + ajout -->
        <HBox styleClass="toolbar-card" alignment="CENTER_LEFT">
            <StackPane alignment="CENTER_LEFT" prefWidth="346.0" minWidth="200.0">
                <TextField fx:id="txtRecherche" styleClass="search-field"
                           promptText="Rechercher une dépense..."/>
                <SVGPath styleClass="icone-recherche" mouseTransparent="true"
                         content="M11 3a8 8 0 1 0 0 16a8 8 0 1 0 0-16 M21 21l-4.35-4.35">
                    <StackPane.margin>
                        <Insets left="9.0"/>
                    </StackPane.margin>
                </SVGPath>
            </StackPane>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnNouvelle" text="Ajouter une dépense" styleClass="add-btn" onAction="#onNouvelle">
                <graphic>
                    <SVGPath styleClass="icone-blanche" content="M12 5v14 M5 12h14"/>
                </graphic>
            </Button>
        </HBox>

        <!-- Liste des dépenses -->
        <VBox styleClass="table-card">
            <TableView fx:id="tableDepenses" styleClass="data-table" focusTraversable="false">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colDate" text="DATE" sortable="false" reorderable="false"
                                 minWidth="95.0" prefWidth="100.0" maxWidth="115.0"/>
                    <TableColumn fx:id="colCategorie" text="CATÉGORIE" sortable="false" reorderable="false"
                                 minWidth="125.0" prefWidth="130.0" maxWidth="150.0"/>
                    <TableColumn fx:id="colDescription" text="DESCRIPTION" sortable="false" reorderable="false"
                                 minWidth="240.0" prefWidth="520.0"/>
                    <TableColumn fx:id="colMontant" text="MONTANT (MAD)" sortable="false" reorderable="false"
                                 styleClass="col-droite" minWidth="125.0" prefWidth="130.0" maxWidth="150.0"/>
                    <TableColumn fx:id="colActions" text="ACTIONS" sortable="false" reorderable="false"
                                 styleClass="col-droite" minWidth="80.0" prefWidth="80.0" maxWidth="90.0"/>
                </columns>
            </TableView>

            <HBox styleClass="table-footer" alignment="CENTER_LEFT">
                <Label fx:id="lblPagination" text="Aucune dépense" styleClass="pagination-info"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="6.0" alignment="CENTER_RIGHT">
                    <Button fx:id="btnPrecedent" text="‹" styleClass="page-btn" onAction="#onPagePrecedente"/>
                    <HBox fx:id="boxPages" spacing="6.0" alignment="CENTER"/>
                    <Button fx:id="btnSuivant" text="›" styleClass="page-btn" onAction="#onPageSuivante"/>
                </HBox>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>