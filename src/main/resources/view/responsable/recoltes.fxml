<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!--
  Écran « Récoltes » du responsable (maquette « Récoltes »).
  Chargé dans la zone centrale de responsable-main.fxml : la barre latérale n'est pas ici.
  Contrôleur : ma.ferme.controller.responsable.RecolteController
  Styles     : css/recoltes.css
-->
<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ma.ferme.controller.responsable.RecolteController"
            fx:id="scrollPage" styleClass="page" fitToWidth="true" hbarPolicy="NEVER">

    <stylesheets>
        <URL value="C:\Users\AD\Desktop\gestion-fermes\src\main\resources\css\recoltes.css"/>
    </stylesheets>

    <VBox spacing="24.0" styleClass="page-content">
        <padding>
            <Insets top="28.0" right="36.0" bottom="48.0" left="36.0"/>
        </padding>

        <!-- Titre de la page -->
        <VBox spacing="6.0">
            <Label text="Récoltes" styleClass="page-title"/>
            <Label text="Enregistrement des pesées journalières, suivi du stock disponible et traçabilité"
                   styleClass="page-subtitle" wrapText="true"/>
        </VBox>

        <!-- Stock disponible -->
        <VBox styleClass="card, stock-card" maxWidth="390.0" prefWidth="390.0" spacing="18.0">
            <HBox alignment="CENTER_LEFT">
                <Label text="Stock disponible" styleClass="stock-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane styleClass="stock-icon-box" prefWidth="40.0" prefHeight="40.0"
                           minWidth="40.0" minHeight="40.0" maxWidth="40.0" maxHeight="40.0">
                    <SVGPath styleClass="icone" content="M21 8v13H3V8 M1 3h22v5H1z M10 12h4"/>
                </StackPane>
            </HBox>
            <HBox alignment="BASELINE_LEFT" spacing="6.0">
                <Label fx:id="lblStock" text="0" styleClass="stock-value"/>
                <Label text="kg" styleClass="stock-unit"/>
            </HBox>
        </VBox>

        <!-- Formulaire : nouvelle récolte / modification -->
        <VBox styleClass="card, form-card" spacing="18.0">
            <HBox styleClass="form-card-header" alignment="CENTER_LEFT" spacing="14.0">
                <StackPane styleClass="plus-box" minWidth="34.0" minHeight="34.0"
                           prefWidth="34.0" prefHeight="34.0" maxWidth="34.0" maxHeight="34.0">
                    <SVGPath styleClass="icone" content="M12 2a10 10 0 1 0 0 20a10 10 0 1 0 0-20 M12 8v8 M8 12h8"/>
                </StackPane>
                <VBox spacing="2.0">
                    <Label fx:id="lblTitreFormulaire" text="Nouvelle récolte" styleClass="form-title"/>
                    <Label fx:id="lblSousTitreFormulaire"
                           text="Enregistrement instantané d'une pesée en sortie de serre"
                           styleClass="form-subtitle"/>
                </VBox>
            </HBox>

            <HBox spacing="12.0" alignment="BOTTOM_LEFT">
                <VBox spacing="8.0" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="Poids net (kg)" styleClass="field-label"/>
                    <StackPane alignment="CENTER_RIGHT">
                        <TextField fx:id="txtPoids" promptText="Ex: 850" styleClass="field"
                                   onAction="#onEnregistrer"/>
                        <Label text="kg" styleClass="field-suffix" mouseTransparent="true">
                            <StackPane.margin>
                                <Insets right="14.0"/>
                            </StackPane.margin>
                        </Label>
                    </StackPane>
                </VBox>

                <VBox spacing="8.0" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="Variété" styleClass="field-label"/>
                    <ComboBox fx:id="cmbVariete" editable="true" promptText="Ex: Sweet Million"
                              styleClass="field-combo" maxWidth="Infinity"/>
                </VBox>

                <HBox spacing="8.0" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Button fx:id="btnAnnuler" text="Annuler" styleClass="secondary-btn"
                            visible="false" managed="false" onAction="#onAnnuler"/>
                    <Button fx:id="btnEnregistrer" text="Enregistrer" styleClass="submit-btn"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity" defaultButton="false"
                            onAction="#onEnregistrer">
                        <graphic>
                            <SVGPath styleClass="icone-blanche" content="M20 6L9 17l-5-5"/>
                        </graphic>
                    </Button>
                </HBox>
            </HBox>
        </VBox>

        <!-- Historique des pesées -->
        <VBox styleClass="card, table-card">
            <TableView fx:id="tableRecoltes" styleClass="data-table" focusTraversable="false">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colDate" text="DATE &amp; HEURE" sortable="false" reorderable="false"
                                 minWidth="235.0" prefWidth="235.0"/>
                    <TableColumn fx:id="colPoids" text="POIDS (KG)" sortable="false" reorderable="false"
                                 styleClass="col-droite, col-poids" minWidth="130.0" prefWidth="170.0"/>
                    <TableColumn fx:id="colVariete" text="VARIÉTÉ" sortable="false" reorderable="false"
                                 minWidth="150.0" prefWidth="200.0"/>
                    <TableColumn fx:id="colActions" text="ACTIONS" sortable="false" reorderable="false"
                                 styleClass="col-droite" minWidth="100.0" prefWidth="110.0"/>
                </columns>
            </TableView>

            <HBox styleClass="table-footer" alignment="CENTER_LEFT">
                <Label fx:id="lblPagination" text="Aucune pesée" styleClass="pagination-info"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="6.0" alignment="CENTER_RIGHT">
                    <Button fx:id="btnPrecedent" text="‹" styleClass="page-btn" onAction="#onPagePrecedente"/>
                    <HBox fx:id="boxPages" spacing="6.0" alignment="CENTER"/>
                    <Button fx:id="btnSuivant" text="›" styleClass="page-btn" onAction="#onPageSuivante"/>
                </HBox>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>