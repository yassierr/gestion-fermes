<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!--
  Fenêtre modale « Nouvelle dépense » / « Modifier la dépense », ouverte par la liste (depenses.fxml).
  Contrôleur : ma.ferme.controller.responsable.DepenseController (le même que la liste)
  Styles     : css/depenses.css
-->
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ma.ferme.controller.responsable.DepenseController"
      styleClass="modal-root" spacing="20.0" prefWidth="520.0">

    <stylesheets>
        <URL value="@../../css/depenses.css"/>
    </stylesheets>

    <padding>
        <Insets top="26.0" right="28.0" bottom="26.0" left="28.0"/>
    </padding>

    <VBox spacing="4.0">
        <Label fx:id="lblTitreFormulaire" text="Nouvelle dépense" styleClass="modal-title"/>
        <Label text="Les dépenses sont enregistrées pour votre ferme." styleClass="modal-subtitle"/>
    </VBox>

    <HBox spacing="14.0">
        <VBox spacing="8.0" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Date" styleClass="field-label"/>
            <DatePicker fx:id="dpDate" styleClass="field-combo" maxWidth="Infinity" editable="true"/>
        </VBox>
        <VBox spacing="8.0" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Catégorie" styleClass="field-label"/>
            <ComboBox fx:id="cmbCategorie" promptText="Choisir une catégorie" styleClass="field-combo"
                      maxWidth="Infinity"/>
        </VBox>
    </HBox>

    <VBox spacing="8.0">
        <Label text="Montant (MAD)" styleClass="field-label"/>
        <StackPane alignment="CENTER_RIGHT">
            <TextField fx:id="txtMontant" promptText="Ex: 45000" styleClass="field"/>
            <Label text="MAD" styleClass="field-suffix" mouseTransparent="true">
                <StackPane.margin>
                    <Insets right="14.0"/>
                </StackPane.margin>
            </Label>
        </StackPane>
    </VBox>

    <VBox spacing="8.0">
        <Label text="Description" styleClass="field-label"/>
        <TextArea fx:id="txtDescription" styleClass="field-area" prefRowCount="3" wrapText="true"
                  promptText="Intitulé de la dépense. Touche Entrée : ligne suivante pour le fournisseur ou la référence (facultatif)"/>
    </VBox>

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button text="Annuler" styleClass="secondary-btn" onAction="#onAnnuler" cancelButton="true"/>
        <Button fx:id="btnEnregistrer" text="Enregistrer" styleClass="submit-btn" onAction="#onEnregistrer"
                minWidth="140.0">
            <graphic>
                <SVGPath styleClass="icone-blanche" content="M20 6L9 17l-5-5"/>
            </graphic>
        </Button>
    </HBox>
</VBox>