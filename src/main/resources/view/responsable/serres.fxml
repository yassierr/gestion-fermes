<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ma.ferme.controller.responsable.SerreController">
    <padding>
        <Insets bottom="25" left="25" right="25" top="20" />
    </padding>

    <!-- TOP HEADER BAR -->
    <HBox alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Serres" />
            <Label style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" text="Gestion des unités de culture sous serre, superficies et régulation de l'irrigation" />
        </VBox>
        <Pane HBox.hgrow="ALWAYS" />
        <Button onAction="#handleAjouterSerre" style="-fx-background-color: #1b5e20; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px; -fx-cursor: hand; -fx-background-radius: 6; -fx-padding: 8 14;" text="+ Ajouter une serre" />
    </HBox>

    <!-- ROW 1: KPI CARDS (2 Columns matching mockup) -->
    <GridPane hgap="15" vgap="10">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" percentWidth="50" />
            <ColumnConstraints hgrow="SOMETIMES" percentWidth="50" />
        </columnConstraints>

        <!-- Card 1: Total Serres -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 18; -fx-border-color: #e5e7eb; -fx-border-radius: 8;" GridPane.columnIndex="0">
            <HBox alignment="CENTER_LEFT">
                <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" text="Total Serres" />
                <Pane HBox.hgrow="ALWAYS" />
                <Label style="-fx-text-fill: #16a34a; -fx-background-color: #f0fdf4; -fx-background-radius: 4; -fx-padding: 4 6;" text="🌱" />
            </HBox>
            <VBox prefHeight="8" />
            <Label fx:id="lblTotalSerres" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="18 serres actives" />
        </VBox>

        <!-- Card 2: Surface totale couverte -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 18; -fx-border-color: #e5e7eb; -fx-border-radius: 8;" GridPane.columnIndex="1">
            <HBox alignment="CENTER_LEFT">
                <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" text="Surface totale couverte" />
                <Pane HBox.hgrow="ALWAYS" />
                <Label style="-fx-text-fill: #16a34a; -fx-background-color: #f0fdf4; -fx-background-radius: 4; -fx-padding: 4 6;" text="📐" />
            </HBox>
            <VBox prefHeight="8" />
            <Label fx:id="lblTotalSurface" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="145 000 m²" />
        </VBox>
      <rowConstraints>
         <RowConstraints />
      </rowConstraints>
    </GridPane>

    <!-- ROW 2: SEARCH BAR -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <TextField fx:id="txtSearch" prefWidth="320" promptText="🔍 Rechercher une serre, variété..." style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12; -fx-font-size: 11px;" />
    </HBox>

    <!-- ROW 3: TABLE VIEW CARD -->
    <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15; -fx-border-color: #e5e7eb; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
        <TableView fx:id="tableSerres" prefHeight="320">
            <columns>
                <TableColumn fx:id="colNom" prefWidth="250" text="NOM" />
                <TableColumn fx:id="colSurface" prefWidth="180" text="SURFACE M²" />
                <TableColumn fx:id="colVariete" prefWidth="320" text="VARIÉTÉ DE TOMATE" />
                <TableColumn fx:id="colActions" prefWidth="120" text="ACTIONS" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <!-- Table Footer / Pagination -->
        <HBox alignment="CENTER_LEFT">
            <Label fx:id="lblTableSummary" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;" text="Affichage de 1 à 6 sur 18 serres" />
            <Pane HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="4">
                <Button style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-cursor: hand; -fx-font-size: 11px;" text="&lt;" />
                <Button style="-fx-background-color: #1b5e20; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px;" text="1" />
                <Button style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-cursor: hand; -fx-font-size: 11px;" text="2" />
                <Button style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-cursor: hand; -fx-font-size: 11px;" text="3" />
                <Label style="-fx-text-fill: #6b7280;" text="..." />
                <Button style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-cursor: hand; -fx-font-size: 11px;" text="5" />
                <Button style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-cursor: hand; -fx-font-size: 11px;" text="&gt;" />
            </HBox>
        </HBox>
    </VBox>

</VBox>