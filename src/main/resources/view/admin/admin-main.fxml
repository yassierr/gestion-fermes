
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="ma.ferme.controller.admin.AdminMainController"
    prefWidth="1200"
    prefHeight="750"
    style="-fx-background-color: #f4f6fa;">

    <!-- SIDEBAR -->
    <left>
        <VBox
            prefWidth="235"
            spacing="20"
            style="-fx-background-color: #172554;">

            <padding>
                <Insets top="30" right="15" bottom="20" left="15"/>
            </padding>

            <Label
                text="GESTION FERME"
                style="-fx-font-size: 21px;
                       -fx-font-weight: bold;
                       -fx-text-fill: white;"/>

            <Label
                text="ESPACE ADMINISTRATEUR"
                style="-fx-font-size: 10px;
                       -fx-text-fill: #94a3b8;"/>

            <VBox spacing="10">

                <Button
                    text="Tableau de bord"
                    onAction="#showDashboard"
                    maxWidth="Infinity"
                    prefHeight="42"
                    style="-fx-background-color: #334155;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-background-radius: 7;
                           -fx-cursor: hand;"/>

                <Button
                    text="Gestion des fermes"
                    onAction="#showFermes"
                    maxWidth="Infinity"
                    prefHeight="42"
                    style="-fx-background-color: #334155;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-background-radius: 7;
                           -fx-cursor: hand;"/>

            </VBox>

            <VBox VBox.vgrow="ALWAYS"/>

            <Button
                text="Deconnexion"
                onAction="#logout"
                maxWidth="Infinity"
                prefHeight="42"
                style="-fx-background-color: #991b1b;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-background-radius: 7;
                       -fx-cursor: hand;"/>

        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="20">

            <padding>
                <Insets top="25" right="30" bottom="25" left="30"/>
            </padding>

            <HBox alignment="CENTER_LEFT">
                <Label
                    fx:id="pageTitle"
                    text="Tableau de bord"
                    style="-fx-font-size: 25px;
                           -fx-font-weight: bold;
                           -fx-text-fill: #172554;"/>
            </HBox>

            <StackPane
                fx:id="contentArea"
                VBox.vgrow="ALWAYS"
                style="-fx-background-color: white;
                       -fx-background-radius: 12;
                       -fx-padding: 20;"/>

        </VBox>
    </center>

</BorderPane>
