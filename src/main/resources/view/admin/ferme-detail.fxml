<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" style="-fx-background: #f8fafc; -fx-background-color: #f8fafc; -fx-border-color: transparent;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ma.ferme.controller.admin.FermeDetailController">
    <content>
        <VBox spacing="20">
            <padding>
                <Insets bottom="25" left="25" right="25" top="20" />
            </padding>

            <!-- TOP NAVIGATION & BREADCRUMB -->
            <HBox alignment="CENTER_LEFT">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label style="-fx-text-fill: #6b7280; -fx-font-size: 12px;" text="Fermes" />
                    <Label style="-fx-text-fill: #6b7280; -fx-font-size: 12px;" text="/" />
                    <Label fx:id="lblBreadcrumbName" style="-fx-text-fill: #111827; -fx-font-size: 12px; -fx-font-weight: bold;" text="Domaine Souss Prime" />
                    <Label style="-fx-background-color: #e5e7eb; -fx-background-radius: 4; -fx-padding: 2 6; -fx-font-size: 10px; -fx-text-fill: #374151;" text="🔒 Lecture seule" />
                </HBox>
                <Pane HBox.hgrow="ALWAYS" />
                <Button onAction="#handleRetourFermes" style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-cursor: hand; -fx-font-size: 11px; -fx-padding: 6 12;" text="← Retour aux fermes" />
            </HBox>

            <!-- FARM HEADER CARD -->
            <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: #e5e7eb; -fx-border-radius: 8;">
                <VBox spacing="6">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label style="-fx-text-fill: #16a34a; -fx-font-size: 18px;" text="🌱" />
                        <Label fx:id="lblNomFerme" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Domaine Souss Prime" />
                    </HBox>
                    <Label fx:id="lblLocalisation" style="-fx-text-fill: #6b7280; -fx-font-size: 11px;" text="📍 Biougra, Chtouka Ait Baha" />
                    <HBox spacing="15" style="-fx-padding: 8 0 0 0;">
                        <Label style="-fx-text-fill: #4b5563; -fx-font-size: 11px;" text="👤 Responsable: Driss El Amrani" />
                        <Label style="-fx-text-fill: #4b5563; -fx-font-size: 11px;" text="👥 Agent RH: Youssef Alaoui" />
                    </HBox>
                </VBox>
                <Pane HBox.hgrow="ALWAYS" />
                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" text="SURFACE" />
                    <Label fx:id="lblSurface" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="45 000 m²" />
                </VBox>
            </HBox>

            <!-- STATS GRID (Iteration 3 Statistics) -->
            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" percentWidth="20" />
                    <ColumnConstraints hgrow="SOMETIMES" percentWidth="20" />
                    <ColumnConstraints hgrow="SOMETIMES" percentWidth="20" />
                    <ColumnConstraints hgrow="SOMETIMES" percentWidth="20" />
                    <ColumnConstraints hgrow="SOMETIMES" percentWidth="20" />
                </columnConstraints>

                <!-- Stat 1 -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 8;" GridPane.columnIndex="0">
                    <Label style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" text="STOCK DISPONIBLE" />
                    <VBox prefHeight="4" />
                    <Label fx:id="lblStatStock" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="12 500 kg" />
                </VBox>

                <!-- Stat 2 -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 8;" GridPane.columnIndex="1">
                    <Label style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" text="CHIFFRE D'AFFAIRES" />
                    <VBox prefHeight="4" />
                    <Label fx:id="lblStatCa" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #16a34a;" text="4 820 000 MAD" />
                </VBox>

                <!-- Stat 3 -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 8;" GridPane.columnIndex="2">
                    <Label style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" text="BÉNÉFICE" />
                    <VBox prefHeight="4" />
                    <Label fx:id="lblStatBenefice" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #16a34a;" text="1 840 000 MAD" />
                </VBox>

                <!-- Stat 4 -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 8;" GridPane.columnIndex="3">
                    <Label style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" text="EFFECTIF" />
                    <VBox prefHeight="4" />
                    <Label fx:id="lblStatEffectif" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="82 ouvriers" />
                </VBox>

                <!-- Stat 5 -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 8;" GridPane.columnIndex="4">
                    <Label style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" text="MASSE SALARIALE" />
                    <VBox prefHeight="4" />
                    <Label fx:id="lblStatMasseSalariale" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="1 310 000 MAD" />
                </VBox>
            <rowConstraints>
               <RowConstraints />
            </rowConstraints>
            </GridPane>

            <!-- TABS SECTION -->
            <TabPane style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e5e7eb; -fx-border-radius: 8;">
                <!-- Tab 1: Serres -->
                <Tab text="   🌱 Serres   ">
                    <VBox spacing="12" style="-fx-padding: 15;">
                        <HBox alignment="CENTER_LEFT">
                            <TextField fx:id="txtSearchSerre" prefWidth="280" promptText="🔍 Rechercher une serre..." style="-fx-background-color: #f9fafb; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-padding: 6;" />
                            <Pane HBox.hgrow="ALWAYS" />
                            <Label style="-fx-font-size: 11px; -fx-text-fill: #6b7280;" text="Total : 6 serres répertoriées" />
                        </HBox>
                        <TableView fx:id="tableSerres" prefHeight="260">
                            <columns>
                                <TableColumn fx:id="colNomSerre" prefWidth="200" text="Nom de la serre" />
                                <TableColumn fx:id="colSurfaceSerre" prefWidth="150" text="Surface (m²)" />
                                <TableColumn fx:id="colTypeAbri" prefWidth="180" text="Type d'abri" />
                                <TableColumn fx:id="colIrrigation" prefWidth="180" text="Irrigation" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </Tab>

                <!-- Tab 2: Récoltes -->
                <Tab text="   🌾 Récoltes   ">
                    <VBox alignment="CENTER" style="-fx-padding: 40;">
                        <Label style="-fx-text-fill: #6b7280;" text="Historique des récoltes pour cette ferme." />
                    </VBox>
                </Tab>

                <!-- Tab 3: Dépenses -->
                <Tab text="   💰 Dépenses   ">
                    <VBox alignment="CENTER" style="-fx-padding: 40;">
                        <Label style="-fx-text-fill: #6b7280;" text="Suivi des dépenses et charges de la ferme." />
                    </VBox>
                </Tab>

                <!-- Tab 4: Ouvriers -->
                <Tab text="   👥 Ouvriers   ">
                    <VBox alignment="CENTER" style="-fx-padding: 40;">
                        <Label style="-fx-text-fill: #6b7280;" text="Liste des ouvriers affectés à cette ferme." />
                    </VBox>
                </Tab>

                <!-- Tab 5: Reçus de paie -->
                <Tab text="   📄 Reçus de paie   ">
                    <VBox alignment="CENTER" style="-fx-padding: 40;">
                        <Label style="-fx-text-fill: #6b7280;" text="Historique des reçus de paie de la ferme." />
                    </VBox>
                </Tab>
            </TabPane>

        </VBox>
    </content>
</ScrollPane>