<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  Modal : Créer une livraison.
  Chemin : src/main/resources/view/admin/livraison-form.fxml
  Contrôleur : ma.ferme.controller.admin.LivraisonFormController
-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ma.ferme.controller.admin.LivraisonFormController"
      stylesheets="@../../css/livraison-form.css"
      styleClass="lf-root"
      prefWidth="720" prefHeight="640">

    <!-- ===== EN-TÊTE ===== -->
    <HBox styleClass="lf-header" alignment="CENTER_LEFT">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Créer une livraison" styleClass="lf-title"/>
            <Label text="Composez la livraison à partir du stock d'une ou plusieurs fermes."
                   styleClass="lf-subtitle"/>
        </VBox>
        <Button text="✕" onAction="#onAnnuler" styleClass="lf-close"/>
    </HBox>

    <!-- ===== CORPS ===== -->
    <VBox styleClass="lf-body" spacing="14" VBox.vgrow="ALWAYS">

        <!-- Client + date -->
        <HBox spacing="16">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <HBox spacing="3">
                    <Label text="CLIENT / STATION" styleClass="lf-label"/>
                    <Label text="*" styleClass="lf-required"/>
                </HBox>
                <ComboBox fx:id="cbClient" promptText="Choisir un client"
                          maxWidth="Infinity" styleClass="lf-combo"/>
            </VBox>
            <VBox spacing="5" prefWidth="200">
                <HBox spacing="3">
                    <Label text="DATE DE LIVRAISON" styleClass="lf-label"/>
                    <Label text="*" styleClass="lf-required"/>
                </HBox>
                <DatePicker fx:id="dpDate" maxWidth="Infinity" styleClass="lf-combo"/>
            </VBox>
        </HBox>

        <!-- Bloc d'ajout d'une ligne -->
        <VBox styleClass="lf-line-box" spacing="10">
            <Label text="Ajouter une ligne (une par ferme)" styleClass="lf-section-title"/>

            <HBox spacing="12" alignment="BOTTOM_LEFT">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="FERME" styleClass="lf-label"/>
                    <ComboBox fx:id="cbFerme" promptText="Choisir une ferme"
                              maxWidth="Infinity" styleClass="lf-combo"/>
                </VBox>
                <VBox spacing="5" prefWidth="130">
                    <Label text="QUANTITÉ (KG)" styleClass="lf-label"/>
                    <TextField fx:id="tfQuantite" promptText="Ex : 850" styleClass="lf-field"/>
                </VBox>
                <VBox spacing="5" prefWidth="130">
                    <Label text="PRIX (MAD/KG)" styleClass="lf-label"/>
                    <TextField fx:id="tfPrix" promptText="Ex : 9,20" styleClass="lf-field"/>
                </VBox>
                <Button text="+ Ajouter" onAction="#onAjouterLigne" styleClass="lf-btn-secondary"/>
            </HBox>

            <Label fx:id="lblStock" wrapText="true" minHeight="16" styleClass="lf-stock"/>
        </VBox>

        <!-- Lignes de la livraison -->
        <VBox spacing="8" VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT">
                <Label text="Lignes de la livraison" styleClass="lf-section-title"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button text="Retirer la ligne" onAction="#onRetirerLigne" styleClass="lf-btn-danger"/>
            </HBox>

            <TableView fx:id="tableLignes" VBox.vgrow="ALWAYS" styleClass="lf-table">
                <placeholder>
                    <Label text="Aucune ligne : ajoutez au moins une ferme."/>
                </placeholder>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colFerme" text="FERME"/>
                    <TableColumn fx:id="colQuantite" text="QUANTITÉ (KG)"
                                 style="-fx-alignment: CENTER-RIGHT;"/>
                    <TableColumn fx:id="colPrix" text="PRIX (MAD/KG)"
                                 style="-fx-alignment: CENTER-RIGHT;"/>
                    <TableColumn fx:id="colMontant" text="MONTANT (MAD)"
                                 style="-fx-alignment: CENTER-RIGHT;"/>
                </columns>
            </TableView>

            <HBox alignment="CENTER_RIGHT">
                <Label fx:id="lblTotal" text="Total : 0,00 MAD" styleClass="lf-total"/>
            </HBox>
        </VBox>

        <Label fx:id="lblErreur" wrapText="true" minHeight="18" styleClass="lf-error"/>
    </VBox>

    <!-- ===== PIED ===== -->
    <HBox styleClass="lf-footer" spacing="10" alignment="CENTER_RIGHT">
        <Button text="Annuler" onAction="#onAnnuler" styleClass="lf-btn-cancel"/>
        <Button text="✓ Enregistrer la livraison" onAction="#onEnregistrer"
                styleClass="lf-btn-primary"/>
    </HBox>
</VBox>
