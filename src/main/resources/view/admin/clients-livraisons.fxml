<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  Écran Administrateur : Clients & Livraisons.
  Chemin : src/main/resources/view/admin/clients-livraisons.fxml
  Contrôleur : ma.ferme.controller.admin.ClientLivraisonController
-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ma.ferme.controller.admin.ClientLivraisonController"
      stylesheets="@../../css/clients-livraisons.css"
      styleClass="cl-page-root"
      spacing="16">

    <padding>
        <Insets top="24" right="28" bottom="24" left="28"/>
    </padding>

    <!-- ===== EN-TÊTE ===== -->
    <VBox spacing="4">
        <Label text="Clients &amp; Livraisons" styleClass="cl-page-title"/>
            </VBox>

    <!-- ===== INDICATEURS ===== -->
    <HBox spacing="16">
        <VBox styleClass="cl-kpi-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label text="TOTAL CLIENTS" styleClass="cl-kpi-title"/>
            <Label fx:id="lblTotalClients" text="0" styleClass="cl-kpi-value"/>
        </VBox>
        <VBox styleClass="cl-kpi-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label text="LIVRAISONS ACTIVES" styleClass="cl-kpi-title"/>
            <Label fx:id="lblNbLivraisons" text="0" styleClass="cl-kpi-value"/>
        </VBox>
        <VBox styleClass="cl-kpi-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label text="VOLUME LIVRÉ" styleClass="cl-kpi-title"/>
            <Label fx:id="lblVolume" text="0 kg" styleClass="cl-kpi-value"/>
        </VBox>
        <VBox styleClass="cl-kpi-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label text="CRÉANCES EN COURS" styleClass="cl-kpi-title"/>
            <Label fx:id="lblCreances" text="0 MAD" styleClass="cl-kpi-value-warn"/>
        </VBox>
    </HBox>

    <!-- ===== CLIENTS ===== -->
    <VBox styleClass="cl-table-card" spacing="10" VBox.vgrow="ALWAYS">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Annuaire des Clients" styleClass="cl-section-title"/>
            <TextField fx:id="rechercheClient"
                       promptText="Rechercher par nom de client, ville…"
                       styleClass="cl-search"
                       prefWidth="260"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="+ Ajouter un client" onAction="#onAjouterClient" styleClass="cl-btn-primary"/>
            <Button text="Modifier" onAction="#onModifierClient" styleClass="cl-btn-secondary"/>
            <Button text="Supprimer" onAction="#onSupprimerClient" styleClass="cl-btn-danger"/>
        </HBox>

        <TableView fx:id="tableClients" VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="Aucun client."/>
            </placeholder>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colCode" text="CODE"/>
                <TableColumn fx:id="colNom" text="CLIENT"/>
                <TableColumn fx:id="colType" text="TYPE"/>
                <TableColumn fx:id="colTelephone" text="TÉLÉPHONE"/>
                <TableColumn fx:id="colVille" text="VILLE"/>
            </columns>
        </TableView>
    </VBox>

    <!-- ===== LIVRAISONS ===== -->
    <VBox styleClass="cl-table-card" spacing="10" VBox.vgrow="ALWAYS">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Registre des Livraisons" styleClass="cl-section-title"/>
            <TextField fx:id="rechercheLivraison"
                       promptText="Rechercher par n° de bon, client…"
                       styleClass="cl-search"
                       prefWidth="260"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="+ Créer une commande" onAction="#onCreerLivraison" styleClass="cl-btn-primary"/>
            <Button text="Marquer payée" onAction="#onMarquerPayee" styleClass="cl-btn-secondary"/>
            <Button text="Bon de livraison PDF" onAction="#onBonPdf" styleClass="cl-btn-secondary"/>
            <Button text="Annuler" onAction="#onAnnulerLivraison" styleClass="cl-btn-danger"/>
        </HBox>

        <TableView fx:id="tableVentes" VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="Aucune livraison."/>
            </placeholder>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colBon" text="N° LIVRAISON"/>
                <TableColumn fx:id="colDate" text="DATE"/>
                <TableColumn fx:id="colClientVente" text="CLIENT / STATION"/>
                <TableColumn fx:id="colFermes" text="FERMES CONCERNÉES"/>
                <TableColumn fx:id="colVolume" text="VOLUME (KG)"
                             style="-fx-alignment: CENTER-RIGHT;"/>
                <TableColumn fx:id="colMontant" text="MONTANT (MAD)"
                             style="-fx-alignment: CENTER-RIGHT;"/>
                <TableColumn fx:id="colStatut" text="STATUT"
                             style="-fx-alignment: CENTER;"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
