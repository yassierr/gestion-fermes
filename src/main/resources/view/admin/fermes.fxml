<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ma.ferme.controller.admin.FermeController">
    <padding>
        <Insets bottom="25" left="25" right="25" top="20" />
    </padding>

    <!-- TOP HEADER BAR -->
    <HBox alignment="CENTER_LEFT">
        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Gestion des Fermes" />
    </HBox>

    <!-- ROW 1: KPI CARDS (3 Columns) -->
    <GridPane hgap="15" vgap="10">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" percentWidth="33.33" />
            <ColumnConstraints hgrow="SOMETIMES" percentWidth="33.33" />
            <ColumnConstraints hgrow="SOMETIMES" percentWidth="33.33" />
        </columnConstraints>

        <!-- Card 1: Nombre de fermes -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15; -fx-border-color: #e5e7eb; -fx-border-radius: 8;" GridPane.columnIndex="0">
            <HBox alignment="CENTER_LEFT">
                <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" text="NOMBRE DE FERMES" />
                <Pane HBox.hgrow="ALWAYS" />
                <Label style="-fx-text-fill: #16a34a;" text="🌱" />
            </HBox>
            <VBox prefHeight="5" />
            <Label fx:id="lblTotalFarms" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="0 fermes" />
        </VBox>

        <!-- Card 2: Surface totale -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15; -fx-border-color: #e5e7eb; -fx-border-radius: 8;" GridPane.columnIndex="1">
            <HBox alignment="CENTER_LEFT">
                <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" text="SURFACE TOTALE" />
                <Pane HBox.hgrow="ALWAYS" />
                <Label style="-fx-text-fill: #16a34a;" text="📐" />
            </HBox>
            <VBox prefHeight="5" />
            <Label fx:id="lblTotalArea" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="185 000 m²" />
        </VBox>

        <!-- Card 3: Stock disponible total -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15; -fx-border-color: #e5e7eb; -fx-border-radius: 8;" GridPane.columnIndex="2">
            <HBox alignment="CENTER_LEFT">
                <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" text="STOCK DISPONIBLE TOTAL" />
                <Pane HBox.hgrow="ALWAYS" />
                <Label style="-fx-text-fill: #16a34a;" text="📦" />
            </HBox>
            <VBox prefHeight="5" />
            <Label fx:id="lblTotalStock" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="42 850 kg" />
        </VBox>

        <rowConstraints>
            <RowConstraints />
        </rowConstraints>
    </GridPane>

    <!-- ROW 2: SEARCH & ADD BUTTON BAR -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <TextField fx:id="txtSearch" prefWidth="320" promptText="🔍 Rechercher par nom de ferme ou responsable..." style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 10; -fx-font-size: 11px;" />
        <Pane HBox.hgrow="ALWAYS" />
        <Button onAction="#handleAjouterFerme" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px; -fx-cursor: hand; -fx-background-radius: 6; -fx-padding: 7 14;" text="➕ Ajouter une ferme" />
    </HBox>

    <!-- ROW 3: TABLE VIEW CARD -->
    <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15; -fx-border-color: #e5e7eb; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
        <TableView fx:id="tableFermes" prefHeight="320">
            <columns>
                <TableColumn fx:id="colNom" prefWidth="180" text="NOM DE FERME" />
                <TableColumn fx:id="colLocalisation" prefWidth="200" text="LOCALISATION" />
                <TableColumn fx:id="colResponsable" prefWidth="150" text="RESPONSABLE" />
                <TableColumn fx:id="colAgentRh" prefWidth="150" text="AGENT RH" />
                <TableColumn fx:id="colStock" prefWidth="120" text="STOCK DISPONIBLE" />
                <TableColumn fx:id="colActions" prefWidth="90" text="ACTIONS" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <!-- Table Footer / Pagination -->
        <HBox alignment="CENTER_LEFT">
            <Label fx:id="lblTableSummary" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;" text="Affichage de 0 sur 0 fermes" />
            <Pane HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="4">
                <Button style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-cursor: hand; -fx-font-size: 11px;" text="&lt;" />
                <Button style="-fx-background-color: #1b5e20; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px;" text="Page 1" />
                <Button style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-cursor: hand; -fx-font-size: 11px;" text="&gt;" />
            </HBox>
        </HBox>
    </VBox>

</VBox>