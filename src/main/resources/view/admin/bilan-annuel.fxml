<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.SVGPath?>

<!--
  Écran « Bilan annuel » de l'administrateur (maquette « Bilan Annuel »).
  Chargé dans la zone centrale de admin-main.fxml : la barre latérale et la barre du haut ne sont pas ici.
  Contrôleur : ma.ferme.controller.admin.BilanAnnuelController
  Styles     : css/bilan-annuel.css
-->
<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ma.ferme.controller.admin.BilanAnnuelController"
            styleClass="page" fitToWidth="true" hbarPolicy="NEVER">

    <stylesheets>
        <URL value="@../../css/bilan-annuel.css"/>
    </stylesheets>

    <VBox spacing="22.0" styleClass="page-content">
        <padding>
            <Insets top="28.0" right="36.0" bottom="48.0" left="36.0"/>
        </padding>

        <!-- Titre + exercice + export -->
        <HBox alignment="CENTER_LEFT" spacing="14.0">
            <Label text="Bilan Annuel" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox styleClass="exercice-box" alignment="CENTER_LEFT" spacing="8.0">
                <SVGPath styleClass="icone"
                         content="M8 2v4 M16 2v4 M3 10h18 M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/>
                <Label text="Exercice :" styleClass="exercice-label"/>
                <ComboBox fx:id="cmbAnnee" styleClass="field-combo" prefWidth="100.0"/>
            </HBox>
            <Button fx:id="btnExporter" text="Exporter en PDF" styleClass="add-btn" onAction="#onExporter">
                <graphic>
                    <SVGPath styleClass="icone-blanche"
                             content="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M9 13h6 M9 17h6"/>
                </graphic>
            </Button>
        </HBox>

        <!-- Avertissement tant que les données ne sont pas branchées -->
        <Label fx:id="lblAvertissement" styleClass="avertissement" wrapText="true" maxWidth="Infinity"/>

        <!-- Trois indicateurs -->
        <HBox spacing="18.0">
            <VBox styleClass="stat-card" spacing="10.0" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <HBox alignment="CENTER_LEFT">
                    <Label text="GAINS ENCAISSÉS" styleClass="stat-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <StackPane styleClass="stat-icon-vert" minWidth="26.0" minHeight="26.0"
                               prefWidth="26.0" prefHeight="26.0" maxWidth="26.0" maxHeight="26.0">
                        <SVGPath styleClass="icone-stat-vert"
                                 content="M2 7h20v10H2z M12 9.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z"/>
                    </StackPane>
                </HBox>
                <HBox alignment="BASELINE_LEFT" spacing="5.0">
                    <Label fx:id="lblGains" text="0" styleClass="stat-value"/>
                    <Label text="MAD" styleClass="stat-unit"/>
                </HBox>
            </VBox>

            <VBox styleClass="stat-card" spacing="10.0" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <HBox alignment="CENTER_LEFT">
                    <Label text="DÉPENSES TOTALES" styleClass="stat-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <StackPane styleClass="stat-icon-bleu" minWidth="26.0" minHeight="26.0"
                               prefWidth="26.0" prefHeight="26.0" maxWidth="26.0" maxHeight="26.0">
                        <SVGPath styleClass="icone-stat-bleu"
                                 content="M21 12V7H5a2 2 0 0 1 0-4h14v4 M3 5v14a2 2 0 0 0 2 2h16v-5 M18 12a2 2 0 0 0 0 4h4v-4z"/>
                    </StackPane>
                </HBox>
                <HBox alignment="BASELINE_LEFT" spacing="5.0">
                    <Label fx:id="lblDepenses" text="0" styleClass="stat-value"/>
                    <Label text="MAD" styleClass="stat-unit"/>
                </HBox>
            </VBox>

            <VBox styleClass="stat-card, stat-card-net" spacing="10.0" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <HBox alignment="CENTER_LEFT">
                    <Label text="RÉSULTAT NET D'EXPLOITATION" styleClass="stat-label-net"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <StackPane styleClass="stat-icon-fonce" minWidth="26.0" minHeight="26.0"
                               prefWidth="26.0" prefHeight="26.0" maxWidth="26.0" maxHeight="26.0">
                        <SVGPath styleClass="icone-stat-fonce" content="M3 17l6-6 4 4 8-8 M15 7h6v6"/>
                    </StackPane>
                </HBox>
                <HBox alignment="BASELINE_LEFT" spacing="5.0">
                    <Label fx:id="lblResultat" text="0" styleClass="stat-value-net"/>
                    <Label text="MAD" styleClass="stat-unit"/>
                </HBox>
            </VBox>
        </HBox>

        <!-- Graphique mensuel -->
        <VBox styleClass="carte" spacing="8.0">
            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <Label text="Évolution Mensuelle : Gains vs Dépenses" styleClass="carte-titre"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER_LEFT" spacing="6.0">
                    <Rectangle width="9.0" height="9.0" styleClass="legende-gains" arcWidth="2.0" arcHeight="2.0"/>
                    <Label text="Gains (MAD)" styleClass="legende-texte"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="6.0">
                    <Rectangle width="9.0" height="9.0" styleClass="legende-depenses" arcWidth="2.0" arcHeight="2.0"/>
                    <Label text="Dépenses (MAD)" styleClass="legende-texte"/>
                </HBox>
            </HBox>
            <BarChart fx:id="chartMensuel" styleClass="graphique" prefHeight="300.0" minHeight="300.0"
                      barGap="3.0" categoryGap="14.0">
                <xAxis>
                    <CategoryAxis/>
                </xAxis>
                <yAxis>
                    <NumberAxis fx:id="axeMontants" side="LEFT"/>
                </yAxis>
            </BarChart>
        </VBox>

        <!-- Ventilation par ferme -->
        <VBox styleClass="table-card">
            <HBox styleClass="table-entete" alignment="CENTER_LEFT" spacing="10.0">
                <SVGPath styleClass="icone-vert"
                         content="M12 22V12 M12 12C12 7 8 4 3 4c0 5 3 8 9 8 M12 14c0-4 3-7 9-7 0 5-3 7-9 7"/>
                <Label text="Ventilation Financière par Exploitation" styleClass="carte-titre-petit"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblNbFermes" text="0 ferme répertoriée" styleClass="badge-nombre"/>
            </HBox>
            <TableView fx:id="tableFermes" styleClass="data-table" focusTraversable="false" prefHeight="400.0">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="Aucune donnée pour cet exercice" styleClass="placeholder-texte"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="colFerme" text="FERME" sortable="false" reorderable="false"
                                 minWidth="250.0" prefWidth="340.0"/>
                    <TableColumn fx:id="colSurface" text="SURFACE" sortable="false" reorderable="false"
                                 styleClass="col-droite" minWidth="100.0" prefWidth="120.0"/>
                    <TableColumn fx:id="colGains" text="GAINS" sortable="false" reorderable="false"
                                 styleClass="col-droite" minWidth="130.0" prefWidth="150.0"/>
                    <TableColumn fx:id="colDepenses" text="DÉPENSES D'EXPLOITATION" sortable="false" reorderable="false"
                                 styleClass="col-droite" minWidth="180.0" prefWidth="200.0"/>
                    <TableColumn fx:id="colMainOeuvre" text="MAIN-D'ŒUVRE (REÇUS DE PAIE)" sortable="false" reorderable="false"
                                 styleClass="col-droite" minWidth="200.0" prefWidth="220.0"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>